From 76e95f0292fa274cbbbf92b5a07665c3270651f1 Mon Sep 17 00:00:00 2001
From: Paulo Freitas <dudufreitas28@gmail.com>
Date: Fri, 18 Sep 2026 19:13:24 +0000
Subject: [PATCH] Add seven Frameline catalog cases to homepage grid

Replace the mixed featured work row with seven Frameline screen templates
from the live catalog, each with a short title and description. Posters are
sourced from frameline.ai and optimized as WebP under public/work/cases/frameline.
---
 app/globals.css                               |  17 ++++
 .../work/cases/frameline/bridge-dither.webp   | Bin 0 -> 519988 bytes
 public/work/cases/frameline/forgeai-hero.webp | Bin 0 -> 80780 bytes
 .../cases/frameline/frameline-catalog.webp    | Bin 0 -> 154230 bytes
 .../work/cases/frameline/miracle-login.webp   | Bin 0 -> 165580 bytes
 .../work/cases/frameline/passo-running.webp   | Bin 0 -> 74714 bytes
 public/work/cases/frameline/pulse-hero.webp   | Bin 0 -> 70752 bytes
 .../work/cases/frameline/softwave-hero.webp   | Bin 0 -> 68126 bytes
 src/components/FrameWorkGrid.tsx              |  13 +++-
 src/components/HomeFeaturedWork.tsx           |   4 +-
 src/content/home.ts                           |  73 +++++++++++++-----
 11 files changed, 84 insertions(+), 23 deletions(-)
 create mode 100644 public/work/cases/frameline/bridge-dither.webp
 create mode 100644 public/work/cases/frameline/forgeai-hero.webp
 create mode 100644 public/work/cases/frameline/frameline-catalog.webp
 create mode 100644 public/work/cases/frameline/miracle-login.webp
 create mode 100644 public/work/cases/frameline/passo-running.webp
 create mode 100644 public/work/cases/frameline/pulse-hero.webp
 create mode 100644 public/work/cases/frameline/softwave-hero.webp

diff --git a/app/globals.css b/app/globals.css
index e401239..aa3c2a8 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -2947,6 +2947,23 @@ a.frame-hero__company {
   gap: 1rem;
 }
 
+.frame-work__copy {
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  min-width: 0;
+}
+
+.frame-work__detail {
+  margin: 0;
+  max-width: 36ch;
+  font-size: 0.8125rem;
+  line-height: 1.45;
+  letter-spacing: -0.01em;
+  text-transform: none;
+  color: var(--frame-body);
+}
+
 .frame-work__title,
 .frame-work__role {
   font-family: var(--font-geist-mono), ui-monospace, monospace;
diff --git a/public/work/cases/frameline/bridge-dither.webp b/public/work/cases/frameline/bridge-dither.webp
